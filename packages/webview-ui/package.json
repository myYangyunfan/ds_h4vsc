{
  "name": "@dsh-vscode/webview-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Chat webview UI for the DeepSeek Harness VS Code extension.",
  "type": "module",
  "scripts": {
    "build": "node scripts/copy-codicons.mjs && vite build",
    "dev": "node scripts/copy-codicons.mjs && vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.10.0",
    "markdown-it": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@dsh-vscode/core": "workspace:*",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
