{
  "name": "deepseek-harness",
  "displayName": "DeepSeek Harness",
  "description": "%ext.description%",
  "version": "0.8.7",
  "publisher": "dsh-tools",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/deepseek_harness"
  },
  "bugs": {
    "url": "https://github.com/your-org/deepseek_harness/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": ["AI", "Chat", "Programming Languages"],
  "keywords": ["ai", "agent", "deepseek", "harness", "chat", "copilot", "coding assistant"],
  "activationEvents": ["onView:dsh.chat", "onView:dsh.sessions"],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dsh-sidebar",
          "title": "DeepSeek Harness",
          "icon": "media/icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "dsh",
          "title": "DeepSeek Harness",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dsh": [
        {
          "type": "webview",
          "id": "dsh.chat",
          "name": "%view.chat%"
        }
      ],
      "dsh-sidebar": [
        {
          "type": "tree",
          "id": "dsh.sessions",
          "name": "%view.sessions%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dsh.sessions",
        "contents": "%welcome.sessions%"
      }
    ],
    "commands": [
      {
        "command": "dsh.newChat",
        "title": "%cmd.newChat%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "dsh.chat.resume",
        "title": "%cmd.resume%",
        "category": "%category%",
        "icon": "$(history)"
      },
      {
        "command": "dsh.chat.openPanel",
        "title": "%cmd.openPanel%",
        "category": "%category%",
        "icon": "media/icon.svg"
      },
      {
        "command": "dsh.sessions.open",
        "title": "%cmd.sessions.open%",
        "category": "%category%"
      },
      {
        "command": "dsh.sessions.rename",
        "title": "%cmd.sessions.rename%",
        "category": "%category%",
        "icon": "$(edit)"
      },
      {
        "command": "dsh.sessions.delete",
        "title": "%cmd.sessions.delete%",
        "category": "%category%",
        "icon": "$(trash)"
      },
      {
        "command": "dsh.sessions.refresh",
        "title": "%cmd.sessions.refresh%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "dsh.chat.addToChat",
        "title": "%cmd.addToChat%",
        "category": "%category%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dsh.chat.explainSelection",
        "title": "%cmd.explainSelection%",
        "category": "%category%"
      },
      {
        "command": "dsh.reviewChanges",
        "title": "%cmd.reviewChanges%",
        "category": "%category%",
        "icon": "$(eye)"
      },
      {
        "command": "dsh.chat.inlineEdit",
        "title": "%cmd.inlineEdit%",
        "category": "%category%"
      },
      {
        "command": "dsh.exportChat",
        "title": "%cmd.exportChat%",
        "category": "%category%"
      },
      {
        "command": "dsh.renameSession",
        "title": "%cmd.renameSession%",
        "category": "%category%"
      },
      {
        "command": "dsh.deleteSession",
        "title": "%cmd.deleteSession%",
        "category": "%category%"
      },
      {
        "command": "dsh.gitCommitMessage",
        "title": "%cmd.gitCommitMessage%",
        "category": "%category%",
        "icon": "$(git-commit)"
      },
      {
        "command": "dsh.copyDiagnostics",
        "title": "%cmd.copyDiagnostics%",
        "category": "%category%"
      },
      {
        "command": "dsh.verify",
        "title": "%cmd.verify%",
        "category": "%category%"
      },
      {
        "command": "dsh.statusMenu",
        "title": "%cmd.statusMenu%",
        "category": "%category%"
      },
      {
        "command": "dsh.acceptCurrentEdit",
        "title": "%cmd.acceptCurrentEdit%",
        "category": "%category%",
        "icon": "$(check)"
      },
      {
        "command": "dsh.rejectCurrentEdit",
        "title": "%cmd.rejectCurrentEdit%",
        "category": "%category%",
        "icon": "$(close)"
      },
      {
        "command": "dsh.chat.explainClipboard",
        "title": "%cmd.explainClipboard%",
        "category": "%category%"
      },
      {
        "command": "dsh.createAgentsFile",
        "title": "%cmd.createAgentsFile%",
        "category": "%category%"
      },
      {
        "command": "dsh.quickAsk",
        "title": "%cmd.quickAsk%",
        "category": "%category%"
      },
      {
        "command": "dsh.chat.refactorSelection",
        "title": "%cmd.refactorSelection%",
        "category": "%category%"
      },
      {
        "command": "dsh.chat.explainProblem",
        "title": "%cmd.explainProblem%",
        "category": "%category%"
      },
      {
        "command": "dsh.setApiKey",
        "title": "%cmd.setApiKey%",
        "category": "%category%"
      },
      {
        "command": "dsh.clearApiKey",
        "title": "%cmd.clearApiKey%",
        "category": "%category%"
      },
      {
        "command": "dsh.showApiKeyStatus",
        "title": "%cmd.showApiKeyStatus%",
        "category": "%category%"
      },
      {
        "command": "dsh.installKernel",
        "title": "%cmd.installKernel%",
        "category": "%category%"
      },
      {
        "command": "dsh.showLogs",
        "title": "%cmd.showLogs%",
        "category": "%category%"
      },
      {
        "command": "dsh.openSettings",
        "title": "%cmd.openSettings%",
        "category": "%category%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dsh.newChat",
          "when": "view == dsh.chat",
          "group": "navigation@1"
        },
        {
          "command": "dsh.chat.resume",
          "when": "view == dsh.chat",
          "group": "navigation@2"
        },
        {
          "command": "dsh.sessions.refresh",
          "when": "view == dsh.sessions",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "dsh.sessions.rename",
          "when": "view == dsh.sessions && viewItem == dsh.session",
          "group": "inline@1"
        },
        {
          "command": "dsh.sessions.delete",
          "when": "view == dsh.sessions && viewItem == dsh.session",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dsh.sessions.open",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "dsh.chat.addToChat",
          "group": "dsh@1"
        },
        {
          "command": "dsh.chat.explainSelection",
          "when": "editorHasSelection",
          "group": "dsh@2"
        },
        {
          "command": "dsh.chat.refactorSelection",
          "when": "editorHasSelection",
          "group": "dsh@3"
        }
      ],
      "problems/context": [
        {
          "command": "dsh.chat.explainProblem",
          "group": "dsh@1"
        }
      ],
      "scm/title": [
        {
          "command": "dsh.gitCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@-1"
        }
      ],
      "editor/title": [
        {
          "command": "dsh.chat.openPanel",
          "group": "navigation@0"
        },
        {
          "command": "dsh.chat.addToChat",
          "group": "navigation@9"
        },
        {
          "command": "dsh.acceptCurrentEdit",
          "when": "resourceScheme == dsh-edit",
          "group": "navigation@1"
        },
        {
          "command": "dsh.rejectCurrentEdit",
          "when": "resourceScheme == dsh-edit",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dsh.chat.openPanel",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      },
      {
        "command": "dsh.newChat",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "dsh.reviewChanges",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      },
      {
        "command": "dsh.chat.inlineEdit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      },
      {
        "command": "dsh.chat.addToChat",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "dsh.chat.explainSelection",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e"
      }
    ],
    "walkthroughs": [
      {
        "id": "dsh.getStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "openChat",
            "title": "%walkthrough.openChat.title%",
            "description": "%walkthrough.openChat.description%",
            "media": { "markdown": "media/walkthrough/open-chat.md" },
            "completionEvents": ["onCommand:dsh.chat.openPanel"]
          },
          {
            "id": "setup",
            "title": "%walkthrough.setup.title%",
            "description": "%walkthrough.setup.description%",
            "media": { "markdown": "media/walkthrough/setup.md" },
            "completionEvents": ["onCommand:dsh.setApiKey"]
          },
          {
            "id": "review",
            "title": "%walkthrough.review.title%",
            "description": "%walkthrough.review.description%",
            "media": { "markdown": "media/walkthrough/review.md" },
            "completionEvents": ["onCommand:dsh.reviewChanges"]
          },
          {
            "id": "shortcuts",
            "title": "%walkthrough.shortcuts.title%",
            "description": "%walkthrough.shortcuts.description%",
            "media": { "markdown": "media/walkthrough/shortcuts.md" },
            "completionEvents": ["onCommand:dsh.chat.openPanel"]
          }
        ]
      }
    ],
    "configuration": [
      {
        "title": "%config.kernel%",
        "order": 1,
        "properties": {
          "dsh.executablePath": {
            "type": "string",
            "default": "",
            "order": 1,
            "description": "%setting.executablePath%"
          },
          "dsh.preferredVersion": {
            "type": "string",
            "default": "",
            "order": 2,
            "description": "%setting.preferredVersion%"
          },
          "dsh.homeDir": {
            "type": "string",
            "default": "",
            "order": 3,
            "description": "%setting.homeDir%"
          }
        }
      },
      {
        "title": "%config.behavior%",
        "order": 2,
        "properties": {
          "dsh.autoApproveReadOnly": {
            "type": "boolean",
            "default": false,
            "order": 1,
            "description": "%setting.autoApproveReadOnly%"
          },
          "dsh.attachActiveSelection": {
            "type": "boolean",
            "default": true,
            "order": 2,
            "description": "%setting.attachActiveSelection%"
          },
          "dsh.autoOpenReview": {
            "type": "boolean",
            "default": true,
            "order": 3,
            "description": "%setting.autoOpenReview%"
          }
        }
      },
      {
        "title": "%config.acp%",
        "order": 3,
        "properties": {
          "dsh.acpArgs": {
            "type": "array",
            "items": { "type": "string" },
            "default": ["--profile", "acp"],
            "order": 1,
            "description": "%setting.acpArgs%"
          },
          "dsh.acpProfile": {
            "type": "string",
            "default": "acp",
            "order": 2,
            "description": "%setting.acpProfile%"
          },
          "dsh.acpPluginPackage": {
            "type": "string",
            "default": "@deepseek-ai/dsh-acp-app",
            "order": 3,
            "description": "%setting.acpPluginPackage%"
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:kernel": "node scripts/verify-kernel.mjs",
    "package": "vsce package --no-dependencies -o dist/deepseek-harness.vsix",
    "vsce:publish": "vsce publish --no-dependencies",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@dsh-vscode/core": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.3.0",
    "esbuild": "^0.25.0",
    "vitest": "^3.2.4"
  }
}
