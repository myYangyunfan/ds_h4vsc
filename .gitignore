.env
.env.*
*.local

# Editor / OS
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.qoder/
*.swp
Thumbs.db
.DS_Store

# Logs
*.log
npm-debug.log*
